<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:CostApp.Models"
               x:TypeArguments="models:Project"
               x:Class="CostApp.ProjectPopup">
    <Border StrokeShape="RoundRectangle 14"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}">
        <VerticalStackLayout Padding="18" Spacing="12" WidthRequest="330" FlowDirection="RightToLeft">
        <Label x:Name="lblTitle"
               Text="مشروع جديد"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />

        <VerticalStackLayout Spacing="4">
            <Label Text="اسم المشروع *" FontSize="14" FontAttributes="Bold" />
            <Entry x:Name="txtName"
                   Placeholder="مثال: بناء المنزل"
                   HeightRequest="44"
                   MaxLength="100" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="4">
            <Label Text="الميزانية المخصصة (اختياري)" FontSize="14" FontAttributes="Bold" />
            <Entry x:Name="txtBudget"
                   Placeholder="0.00"
                   Keyboard="Numeric"
                   HeightRequest="44" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="4">
            <Label Text="ملاحظات / وصف (اختياري)" FontSize="14" FontAttributes="Bold" />
            <Editor x:Name="txtDescription"
                    Placeholder="معلومات أساسية عن المشروع"
                    HeightRequest="80"
                    MaxLength="300" />
        </VerticalStackLayout>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
            <Button Grid.Column="0"
                    Text="إلغاء"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="44" />
            <Button Grid.Column="1"
                    Text="حفظ"
                    Clicked="OnSaveClicked"
                    BackgroundColor="SteelBlue"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="44" />
        </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
