<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:CostApp.Models"
               x:TypeArguments="models:DetailItem"
               x:Class="CostApp.EditPopup">
    <Border StrokeShape="RoundRectangle 14"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}">
        <VerticalStackLayout Padding="18" Spacing="10" WidthRequest="330" FlowDirection="RightToLeft">
        <Label x:Name="lblHeader"
               Text="إضافة مصروف"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />

        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="10">
            <Label Grid.Column="0" Grid.Row="0" Text="المبلغ *" VerticalTextAlignment="Center" FontAttributes="Bold" />
            <Entry Grid.Column="1" Grid.Row="0"
                   x:Name="txtAmount"
                   Placeholder="0.00"
                   HeightRequest="42"
                   Keyboard="Numeric" />

            <Label Grid.Column="0" Grid.Row="1" Text="التاريخ" VerticalTextAlignment="Center" FontAttributes="Bold" />
            <DatePicker Grid.Column="1" Grid.Row="1"
                        x:Name="dtpDate"
                        HeightRequest="42" />

            <Label Grid.Column="0" Grid.Row="2" Text="ملاحظات" VerticalTextAlignment="Start" FontAttributes="Bold" Margin="0,8,0,0" />
            <Editor Grid.Column="1" Grid.Row="2"
                    x:Name="txtNote"
                    Placeholder="وصف أو ملاحظة (اختياري)"
                    HeightRequest="76"
                    MaxLength="250" />

            <Label Grid.Column="0" Grid.Row="3" x:Name="lblpicker" Text="التصنيف" VerticalTextAlignment="Center" FontAttributes="Bold" />
            <Picker Grid.Column="1" Grid.Row="3"
                    x:Name="pickerItems"
                    x:DataType="models:TreeItem"
                    ItemDisplayBinding="{Binding Title}"
                    HeightRequest="42" />
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
            <Button Grid.Column="0"
                    x:Name="BtnCancel"
                    Text="إلغاء"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="44" />
            <Button Grid.Column="1"
                    x:Name="BtnSave"
                    Text="حفظ"
                    Clicked="OnSaveClicked"
                    BackgroundColor="SteelBlue"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="44" />
        </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
